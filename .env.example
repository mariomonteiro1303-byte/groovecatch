# GrooveCatch Web v1.4
# Links individuais do Spotify usam o oEmbed público e NÃO exigem Client ID/Secret.
# Nenhum segredo é necessário para o fluxo básico.

# Publicidade direta / afiliados (opcional). Configure no Render > Environment.
# Não use URLs encurtadas nem HTML/JS de anunciantes.
GROOVECATCH_SPONSOR_1_TITLE=
GROOVECATCH_SPONSOR_1_DESCRIPTION=
GROOVECATCH_SPONSOR_1_URL=
GROOVECATCH_SPONSOR_2_TITLE=
GROOVECATCH_SPONSOR_2_DESCRIPTION=
GROOVECATCH_SPONSOR_2_URL=
GROOVECATCH_SPONSOR_3_TITLE=
GROOVECATCH_SPONSOR_3_DESCRIPTION=
GROOVECATCH_SPONSOR_3_URL=

# Senha exclusiva do painel /admin/ads (obrigatória para habilitá-lo).
GROOVECATCH_ADS_ADMIN_PASSWORD=
# SQLite de anúncios (temporário no Render Free)
GROOVECATCH_ADS_DB=
